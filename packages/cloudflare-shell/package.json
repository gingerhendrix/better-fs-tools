{
  "name": "@better-fs-tools/cloudflare-shell",
  "version": "0.2.0",
  "description": "A readable and writable filesystem over a Cloudflare Shell Workspace.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gingerhendrix/better-fs-tools.git",
    "directory": "packages/cloudflare-shell"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "dependencies": {
    "@better-fs-tools/fs": "workspace:^"
  },
  "devDependencies": {
    "@better-fs-tools/read": "workspace:^",
    "@better-fs-tools/write": "workspace:^",
    "@cloudflare/shell": "catalog:"
  }
}
