{
  "name": "@better-fs-tools/cloudflare-computer",
  "version": "0.0.0",
  "description": "A readable and writable filesystem over a Cloudflare Computer workspace (experimental).",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "dependencies": {
    "@better-fs-tools/fs": "workspace:^"
  },
  "devDependencies": {
    "@better-fs-tools/read": "workspace:^",
    "@better-fs-tools/write": "workspace:^",
    "@cloudflare/computer": "catalog:"
  }
}
