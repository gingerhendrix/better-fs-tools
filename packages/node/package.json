{
  "name": "@better-fs-tools/node",
  "version": "0.2.0",
  "description": "The Node filesystem, a SHA-256 digest on node:crypto, and a bash runner for Node and Bun.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gingerhendrix/better-fs-tools.git",
    "directory": "packages/node"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "dependencies": {
    "@better-fs-tools/fs": "workspace:^",
    "@better-fs-tools/read": "workspace:^",
    "@better-fs-tools/shell": "workspace:^",
    "@better-fs-tools/write": "workspace:^"
  },
  "engines": {
    "node": ">=24"
  }
}
