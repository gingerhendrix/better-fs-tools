{
  "name": "@better-fs-tools/node",
  "version": "0.0.0",
  "description": "The Node filesystem, a SHA-256 digest, and the zero-config read tool for Node and Bun.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "dependencies": {
    "@better-fs-tools/fs": "workspace:^",
    "@better-fs-tools/read": "workspace:^"
  },
  "engines": {
    "node": ">=24"
  }
}
