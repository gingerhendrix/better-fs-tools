// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`signature presets defaultEditSignature: schema and description snapshot 1`] = `
{
  "description": "Edit a text file by replacing text. \`old_string\` must match exactly one place in the file: add surrounding lines to make it unique, or set \`replace_all\` to change every place. \`old_string\` should match the file exactly. When it does not, a close match is used, and the result says so. A close match may differ in: trailing whitespace, Unicode normalization, curly quotes, dashes, and special spaces. Copy old text from the file without the line-number prefix the read tool adds. Read the file with the read tool before you edit it. After an edit, the same file can be edited again without another read. To create a file or replace all of its content, use the write tool.",
  "grammar": false,
  "name": "edit",
  "schema": {
    "additionalProperties": false,
    "properties": {
      "new_string": {
        "description": "Replacement text. Send an empty string to delete old_string.",
        "type": "string",
      },
      "old_string": {
        "description": "Text to replace. It must match one place in the file unless replace_all is true.",
        "minLength": 1,
        "type": "string",
      },
      "path": {
        "description": "Path of the file to edit, relative to the working directory or absolute within an allowed root.",
        "minLength": 1,
        "pattern": "^[^\\u0000]*[^\\s\\u0000][^\\u0000]*$",
        "type": "string",
      },
      "replace_all": {
        "description": "Replace every place old_string matches. Default false.",
        "type": "boolean",
      },
    },
    "required": [
      "path",
      "old_string",
      "new_string",
    ],
    "type": "object",
  },
}
`;

exports[`signature presets multiEditSignature: schema and description snapshot 1`] = `
{
  "description": "Edit a text file with one or more replacements in one call. Each \`edits[].oldText\` must match exactly one place in the original file. Edits must not overlap or nest: merge nearby changes into one edit. \`edits[].oldText\` should match the file exactly. When it does not, a close match is used, and the result says so. A close match may differ in: trailing whitespace, Unicode normalization, curly quotes, dashes, and special spaces. Copy old text from the file without the line-number prefix the read tool adds. Read the file with the read tool before you edit it. After an edit, the same file can be edited again without another read. To create a file or replace all of its content, use the write tool.",
  "grammar": false,
  "name": "edit",
  "schema": {
    "additionalProperties": false,
    "properties": {
      "edits": {
        "description": "One or more replacements. Each is matched against the original file, not after earlier edits. Merge nearby changes into one edit.",
        "items": {
          "additionalProperties": false,
          "properties": {
            "newText": {
              "description": "Replacement text. Send an empty string to delete oldText.",
              "type": "string",
            },
            "oldText": {
              "description": "Text for one replacement. It must match one place in the original file and must not overlap another edit.",
              "minLength": 1,
              "type": "string",
            },
          },
          "required": [
            "oldText",
            "newText",
          ],
          "type": "object",
        },
        "minItems": 1,
        "type": "array",
      },
      "path": {
        "description": "Path of the file to edit, relative to the working directory or absolute within an allowed root.",
        "minLength": 1,
        "pattern": "^[^\\u0000]*[^\\s\\u0000][^\\u0000]*$",
        "type": "string",
      },
    },
    "required": [
      "path",
      "edits",
    ],
    "type": "object",
  },
}
`;

