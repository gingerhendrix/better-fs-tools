// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`golden output for each default signature defaultEditSignature 1`] = `
[
  "[edit:ambiguous-match] Edit 1: the old_string matches 2 places in /a.txt (lines 1, 3). Add surrounding lines to make it unique, or set replace_all.",
  "Edited /a.txt: 2 replacements (replace all) at lines 1, 3.",
  "[edit:no-match] Edit 1: the old_string was not found in /a.txt.",
]
`;

exports[`golden output for each default signature defaultWriteSignature 1`] = `
[
  "Created /new.md (1 line).",
  "No change to /a.txt: the content is the same.",
]
`;

exports[`golden output for each default signature defaultPatchSignature 1`] = `
[
  
"Success. Updated the following files:
M /a.txt"
,
  
"[apply_patch:patch-verify] Patch validation failed (no files were modified):
- /a.txt: hunk 1: failed to find the expected lines:
    delta"
,
]
`;
