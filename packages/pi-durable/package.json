{
  "name": "@better-fs-tools/pi-durable",
  "version": "0.3.0",
  "description": "The Better FS Tools read, edit, write, apply_patch, and bash tools for the experimental Pi durable harness, over its execution environment.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gingerhendrix/better-fs-tools.git",
