{
  "name": "@better-fs-tools/pi",
  "version": "0.1.0",
  "description": "The Better FS Tools read, edit, write, apply_patch, and bash tools and extension for the Pi coding agent.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gingerhendrix/better-fs-tools.git",
    "directory": "packages/pi"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./extension": "./src/extension.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./extension": {
        "types": "./dist/extension.d.ts",
        "import": "./dist/extension.js"
      }
    },
    "access": "public",
    "pi": {
      "extensions": [
        "./dist/extension.js"
      ]
    }
  },
  "dependencies": {
    "@better-fs-tools/node": "workspace:^",
    "@better-fs-tools/read": "workspace:^",
    "@better-fs-tools/shell": "workspace:^",
    "@better-fs-tools/write": "workspace:^"
  },
  "devDependencies": {
    "@better-fs-tools/fs": "workspace:^",
    "@earendil-works/pi-coding-agent": "catalog:",
    "typebox": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:",
    "typebox": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  }
}
