{
  "name": "@better-fs-tools/read",
  "version": "0.0.0",
  "description": "A bounded file reader for TypeScript agent tools.",
  "license": "MIT",
  "files": [
    "dist",
    "docs"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./formats": "./src/formats/index.ts",
    "./signature": "./src/signature/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./formats": {
        "types": "./dist/formats/index.d.ts",
        "import": "./dist/formats/index.js"
      },
      "./signature": {
        "types": "./dist/signature/index.d.ts",
        "import": "./dist/signature/index.js"
      }
    },
    "access": "public"
  },
  "dependencies": {
    "@better-fs-tools/fs": "workspace:^"
  },
  "devDependencies": {
    "typebox": "catalog:"
  }
}
