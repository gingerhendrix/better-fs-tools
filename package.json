{
  "name": "better-fs-tools",
  "version": "0.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/bun": "^1.3.10",
      "typescript": "^7.0.2"
    }
  },
  "type": "module",
  "scripts": {
    "build": "bun run --filter @better-fs-tools/docs build",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "content": "bun run --filter @better-fs-tools/docs content",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "if find apps packages -type f \\( -name '*.ts' -o -name '*.tsx' -o -name '*.js' -o -name '*.jsx' \\) -print -quit | grep -q .; then oxlint --deny-warnings .; else echo 'No source files to lint'; fi",
    "test": "bun test --pass-with-no-tests",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.0"
}
