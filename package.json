{
  "name": "better-fs-tools",
  "version": "0.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "examples",
      "packages/*"
    ],
    "catalog": {
      "@ai-sdk/openai": "4.0.78",
      "@cloudflare/computer": "0.2.1",
      "@cloudflare/shell": "0.4.3",
      "@earendil-works/pi-coding-agent": "^0.84.2",
      "@types/bun": "^1.3.10",
      "ai": "^7.0.77",
      "just-bash": "3.4.2",
      "typebox": "^1.3.16",
      "typescript": "^7.0.2"
    }
  },
  "type": "module",
  "scripts": {
    "build": "bun run --filter @better-fs-tools/docs build",
    "build:packages": "rm -rf packages/*/dist packages/*/tsconfig.build.tsbuildinfo && tsc -b tsconfig.build.json",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "check:packages": "bun run scripts/check-packages.ts",
    "content": "bun run --filter @better-fs-tools/docs content",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "if find apps packages -type f \\( -name '*.ts' -o -name '*.tsx' -o -name '*.js' -o -name '*.jsx' \\) -print -quit | grep -q .; then oxlint --deny-warnings .; else echo 'No source files to lint'; fi",
    "test": "bun test --pass-with-no-tests",
    "tegami": "node scripts/tegami.mts",
    "test:e2e": "bun test --timeout 120000 ./packages/ai-sdk/test/e2e/openai.e2e.ts",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "^26.4.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "tegami": "1.5.0",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.0"
}
